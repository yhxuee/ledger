    "Finsy cannot recover an encrypted ledger if every authorized copy of its encryption key is lost. Keep at least one authorized device or transfer the key when replacing devices.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finsy cannot recover an encrypted ledger if every authorized copy of its encryption key is lost. Keep at least one authorized device or transfer the key when replacing devices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果账本加密密钥的所有已授权副本全部丢失，Finsy 将无法恢复加密账本。请保留至少一台已授权设备，或在更换设备时转移密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若帳本加密金鑰的所有已授權複本全部遺失，Finsy 將無法復原加密帳本。請保留至少一部已授權裝置，或在更換裝置時轉移金鑰。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認されたすべてのデバイスで暗号化キーが失われた場合、Finsyは暗号化された台帳を復元できません。少なくとも1台の承認済みデバイスを保持するか、デバイス交換時にキーを移行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인된 모든 기기에서 암호화 키를 분실하면 Finsy는 암호화된 장부를 복구할 수 없습니다. 최소 1대의 승인된 기기를 유지하거나 기기 교체 시 키를 이전하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Finsy не сможет восстановить зашифрованную книгу, если утеряны все копии ключа шифрования. Сохраняйте хотя бы одно авторизованное устройство или передавайте ключ при смене устройств."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finsy no puede recuperar un libro cifrado si se pierden todas las copias autorizadas de su clave de cifrado. Mantén al menos un dispositivo autorizado o transfiere la clave al cambiar de dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finsy kann ein verschlüsseltes Hauptbuch nicht wiederherstellen, wenn alle autorisierten Kopien verloren gehen. Behalten Sie mindestens ein autorisiertes Gerät oder übertragen Sie den Schlüssel bei Gerätewechsel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finsy ne peut pas récupérer un grand livre chiffré si toutes les copies autorisées de la clé sont perdues. Conservez au moins un appareil autorisé ou transférez la clé lors du changement d'appareil."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Finsy ไม่สามารถกู้คืนสมุดบัญชีที่เข้ารหัสได้หากสำเนาคีย์การเข้ารหัสที่ได้รับอนุญาตทั้งหมดสูญหาย เก็บอุปกรณ์ที่ได้รับอนุญาตไว้อย่างน้อยหนึ่งเครื่องหรือถ่ายโอนคีย์เมื่อเปลี่ยนอุปกรณ์"
          }
        }
      }
    },
    "Finsy needs notification permission to send your daily bookkeeping reminders. Please enable notifications in iOS Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finsy needs notification permission to send your daily bookkeeping reminders. Please enable notifications in iOS Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finsy 需要通知权限以发送每日记账提醒。请在 iOS“设置”中开启通知权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Finsy 需要通知權限以發送每日記帳提醒。請在 iOS「設定」中開啟通知權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日の記録リマインダーを送信するには通知権限が必要です。iOSの「設定」で通知を有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 기록 알림을 보내려면 알림 권한이 필요합니다. iOS '설정'에서 알림을 켜주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Finsy требуется разрешение на уведомления для отправки напоминаний о записях. Пожалуйста, включите уведомления в Настройках iOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finsy necesita permiso de notificaciones para enviar recordatorios diarios. Actívalas en Ajustes de iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finsy benötigt die Berechtigung für Mitteilungen für tägliche Erinnerungen. Bitte aktivieren Sie diese in den iOS-Einstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finsy a besoin de l'autorisation d'envoyer des notifications pour vos rappels quotidiens. Activez-les dans Réglages iOS."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Finsy ต้องการการอนุญาตการแจ้งเตือนเพื่อส่งการแจ้งเตือนการบันทึกบัญชีรายวัน โปรดเปิดใช้งานการแจ้งเตือนในการตั้งค่า iOS"
          }
        }
      }
    },
