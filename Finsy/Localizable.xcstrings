    "Sensitive values are protected on this device only. This preference is never included in ledger backups.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensitive values are protected on this device only. This preference is never included in ledger backups."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "敏感数据仅在本设备上受保护。此偏好设置不会包含在账本备份中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "敏感資訊僅在此裝置上受保護。此設定不會包含在帳本備份中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライバシー保護設定はこのデバイスでのみ適用され、台帳バックアップには含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "민감한 정보 보호 설정은 이 기기에만 적용되며 장부 백업에 포함되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфиденциальные данные защищены только на этом устройстве и не сохраняются в копиях."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores confidenciales están protegidos solo en este dispositivo. Esta preferencia no se incluye en las copias."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensible Werte sind nur auf diesem Gerät geschützt. Diese Einstellung wird nicht in Sicherungen aufgenommen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données sensibles sont protégées uniquement sur cet appareil et exclues des sauvegardes."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าที่ละเอียดอ่อนได้รับการปกป้องบนอุปกรณ์นี้เท่านั้น การตั้งค่านี้จะไม่รวมอยู่ในการสำรองข้อมูลสมุดบัญชี"
          }
        }
      }
    },
