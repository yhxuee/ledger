    "VisionKit camera scanning is unavailable on this device simulator. Use AirDrop to transfer the pairing file.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VisionKit camera scanning is unavailable on this device simulator. Use AirDrop to transfer the pairing file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟器设备不支持相机扫码，请使用隔空投送或文件共享配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模擬器裝置不支援相機掃碼，請使用 AirDrop 或檔案共享配對。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シミュレーターではカメラ機能を利用できません。AirDropでペアリングファイルを転送してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시뮬레이터에서는 카메라 스캔을 지원하지 않습니다. AirDrop으로 페어링 파일을 전송하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирование камерой VisionKit недоступно в симуляторе. Используйте AirDrop для передачи файла сопряжения."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escaneo de cámara VisionKit no está disponible en este simulador. Usa AirDrop para transferir el archivo de emparejamiento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VisionKit-Kamerascannen ist im Simulator nicht verfügbar. Verwenden Sie AirDrop zur Dateiübertragung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scan par caméra VisionKit n'est pas disponible sur simulateur. Utilisez AirDrop pour transférer le fichier."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสแกนกล้อง VisionKit ไม่พร้อมใช้งานบนตัวจำลองอุปกรณ์นี้ ใช้ AirDrop เพื่อถ่ายโอนไฟล์การจับคู่"
          }
        }
      }
    },
