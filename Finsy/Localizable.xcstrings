    "The account and linked transactions will be soft-deleted and excluded from all totals.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account and linked transactions will be soft-deleted and excluded from all totals."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该账户及关联交易将被标记删除，并不再计入所有统计总额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該帳戶及關聯交易將被標記刪除，並不再計入所有統計總額。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "口座と関連取引は論理削除され、すべての集計から除外されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계좌 및 연결된 거래는 일괄 삭제 처리되며 모든 합계에서 제외됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт и связанные транзакции будут помечены как удаленные и исключены из итогов."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta y las transacciones vinculadas se marcarán como eliminadas y se excluirán de los totales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto und die verknüpften Transaktionen werden als gelöscht markiert und aus allen Summen ausgeschlossen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte et les transactions associées seront masqués et exclus de tous les totaux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีและธุรกรรมที่เชื่อมโยงจะถูกลบแบบไม่ถาวรและแยกออกจากยอดรวมทั้งหมด"
          }
        }
      }
    },
    "The plan could not be saved. Check the amounts and existing settlements.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plan could not be saved. Check the amounts and existing settlements."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存该计划。请检查金额与现有结算状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存該計劃。請檢查金額與現有結算狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランを保存できませんでした。金額と既存の精算を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획을 저장할 수 없습니다. 금액과 기존 정산 내역을 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить план. Проверьте суммы и существующие взаиморасчеты."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el plan. Comprueba los importes y liquidaciones existentes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Plan konnte nicht gespeichert werden. Überprüfen Sie die Beträge und Abrechnungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer le plan. Vérifiez les montants et les règlements existants."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถบันทึกแผนได้ ตรวจสอบจำนวนเงินและการหักกลบลบหนี้ที่มีอยู่"
          }
        }
      }
    },
    "The settlement could not be saved.": {
      "extractionState": "manual",
