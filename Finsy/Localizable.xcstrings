    "Interest is recalculated from the current outstanding principal each time it runs.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interest is recalculated from the current outstanding principal each time it runs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次计息均按当前尚未偿还的本金重新计算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次計息均按當前尚未償還的本金重新計算。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行ごとに現在の残存元金から利息が再計算されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행할 때마다 현재 남은 원금을 기준으로 이자가 재계산됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проценты пересчитываются от текущего остатка основного долга при каждом списании."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los intereses se recalculan a partir del principal pendiente actual cada vez que se ejecuta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zinsen werden jedes Mal anhand der aktuellen Restschuld neu berechnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les intérêts sont recalculés à partir du principal restant dû à chaque exécution."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดอกเบี้ยจะถูกคำนวณใหม่จากเงินต้นคงค้างปัจจุบันในแต่ละครั้งที่ดำเนินการ"
          }
        }
      }
    },
