    "Scan the QR code displayed by an unauthorized device, or import its .fsyrequest file via AirDrop.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the QR code displayed by an unauthorized device, or import its .fsyrequest file via AirDrop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描新设备上展示的二维码，或通过隔空投送导入其 .fsyrequest 请求文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描新裝置上展示的 QR 碼，或透過 AirDrop 匯入其 .fsyrequest 請求檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未承認デバイスに表示されたQRコードをスキャンするか、AirDropで.fsyrequestファイルを読み込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미승인 기기에 표시된 QR 코드를 스캔하거나 AirDrop으로 .fsyrequest 파일을 가져오세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканируйте QR-код на неавторизованном устройстве или импортируйте его файл .fsyrequest через AirDrop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el código QR que se muestra en el dispositivo no autorizado o importa su archivo .fsyrequest por AirDrop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannen Sie den QR-Code auf dem nicht autorisierten Gerät oder importieren Sie dessen .fsyrequest-Datei per AirDrop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez le code QR sur l'appareil non autorisé ou importez son fichier .fsyrequest via AirDrop."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกนรหัส QR ที่แสดงโดยอุปกรณ์ที่ไม่ได้รับอนุญาต หรือนำเข้าไฟล์ .fsyrequest ผ่าน AirDrop"
          }
        }
      }
    },
