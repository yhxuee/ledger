    "Overview displays exactly two metric cards. Selecting a duplicate metric automatically swaps the existing card.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overview displays exactly two metric cards. Selecting a duplicate metric automatically swaps the existing card."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "概览顶部固定展示两张指标卡片。若选择重复指标，系统将自动与已有卡片交换位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "總覽頂部固定展示兩張指標卡片。若選擇重複指標，系統將自動與既有卡片交換位置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "概要画面には2枚のメトリクスカードが表示されます。重複する項目を選択すると自動で入れ替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개요 화면에는 2개의 지표 카드가 표시됩니다. 중복 지표를 선택하면 기존 카드와 자동으로 맞바뀝니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В обзоре отображаются ровно две карточки. Выбор дубликата автоматически заменит карточку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resumen muestra exactamente dos tarjetas de métricas. Al seleccionar un duplicado, se intercambia automáticamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übersicht zeigt genau zwei Metrikkarten an. Das Auswählen eines Duplikats tauscht die Karte automatisch aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aperçu affiche exactement deux cartes d'indicateurs. La sélection d'un doublon remplace automatiquement la carte existante."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพรวมจะแสดงการ์ดตัวชี้วัดสองใบพอดี การเลือกตัวชี้วัดที่ซ้ำกันจะสลับกับการ์ดที่มีอยู่โดยอัตโนมัติ"
          }
        }
      }
    },
