    "Future CloudKit records and backups for this ledger will no longer use the ledger encryption key. Existing encrypted backup files remain encrypted.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Future CloudKit records and backups for this ledger will no longer use the ledger encryption key. Existing encrypted backup files remain encrypted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账本未来的 CloudKit 记录和备份将不再使用账本加密密钥。已有的加密备份文件仍将保持加密。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳本未來的 CloudKit 記錄與備份將不再使用帳本加密金鑰。現有的加密備份檔案仍將保持加密。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この台帳の今後のCloudKitレコードとバックアップでは暗号化キーを使用しません。既存の暗号化バックアップファイルは暗号化されたまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장부의 향후 CloudKit 레코드 및 백업은 더 이상 장부 암호화 키를 사용하지 않습니다. 기존 암호화 백업 파일은 암호화된 상태로 유지됩니다."
          }
        }
      }
    },
