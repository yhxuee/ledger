    "This category will no longer appear when creating new transactions. Existing transactions will keep their category information.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This category will no longer appear when creating new transactions. Existing transactions will keep their category information."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此分类在创建新交易时将不再显示。已有交易仍会保留该分类信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此類別在建立新交易時將不再顯示。現有交易仍會保留該類別資訊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカテゴリーは新規取引の作成時に表示されなくなります。既存の取引のカテゴリー情報は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 카테고리는 새로운 거래를 작성할 때 더 이상 표시되지 않습니다. 기존 거래의 카테고리 정보는 유지됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта категория больше не будет отображаться при создании новых транзакций. Существующие транзакции сохранят информацию о категории."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta categoría ya no aparecerá al crear nuevas transacciones. Las transacciones existentes conservarán su información de categoría."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kategorie wird beim Erstellen neuer Transaktionen nicht mehr angezeigt. Bestehende Transaktionen behalten ihre Kategorieinformationen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette catégorie n'apparaîtra plus lors de la création de nouvelles transactions. Les transactions existantes conserveront leurs informations de catégorie."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หมวดหมู่นี้จะไม่แสดงอีกต่อไปเมื่อสร้างธุรกรรมใหม่ ธุรกรรมที่มีอยู่จะยังคงเก็บข้อมูลหมวดหมู่นี้ไว้"
          }
        }
      }
    },
