    "Saving replaces the entire installment schedule, including edited payments.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving replaces the entire installment schedule, including edited payments."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存将替换整个分期计划表（包括已编辑的每期付款）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存將取代整個分期計劃表（包括已編輯的每期付款）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存すると、編集済みの支払いを含む分割払いスケジュール全体が置き換えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하면 편집된 납부 내역을 포함한 전체 할부 일정이 교체됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранение заменит весь график рассрочки, включая отредактированные платежи."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar reemplazará todo el calendario de cuotas, incluidos los pagos editados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern ersetzt den gesamten Ratenplan, einschließlich bearbeiteter Zahlungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement remplace tout l'échéancier, y compris les versements modifiés."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกจะแทนที่กำหนดการผ่อนชำระทั้งหมด รวมถึงการชำระเงินที่แก้ไขแล้ว"
          }
        }
      }
    },
