    "Your current ledger is newer (updated %@).\nThis backup was last updated %@.\n\nReplacing the current ledger may discard newer transactions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your current ledger is newer (updated %@).\nThis backup was last updated %@.\n\nReplacing the current ledger may discard newer transactions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前本地账本更新（更新于 %@）。\n此备份最近更新于 %@。\n\n替换当前账本可能会丢失更新的交易记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前本地帳本更新（更新於 %@）。\n此備份最近更新於 %@。\n\n取代目前帳本可能會遺失更新的交易記錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のローカル台帳の方が最新です（更新日時: %@）。\nこのバックアップの最終更新日時: %@。\n\n現在の台帳を置き換えると最新の取引が失われる可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 로컬 장부가 더 최신입니다 (업데이트: %@).\n이 백업의 마지막 업데이트: %@.\n\n현재 장부를 대체하면 더 최신의 거래 내역이 삭제될 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша текущая книга новее (обновлена %@).\nЭта копия обновлена %@.\n\nЗамена книги может привести к потере новых транзакций."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu libro actual es más reciente (actualizado %@).\nEsta copia se actualizó %@.\n\nReemplazar el libro actual puede descartar transacciones más recientes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr aktuelles Hauptbuch ist neuer (aktualisiert %@).\nDiese Sicherung wurde %@ aktualisiert.\n\nDas Ersetzen verwirft möglicherweise neuere Transaktionen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre grand livre actuel est plus récent (mis à jour le %@).\nCette sauvegarde a été mise à jour le %@.\n\nLe remplacer risque de supprimer les transactions plus récentes."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สมุดบัญชีปัจจุบันของคุณใหม่กว่า (อัปเดต %@)\nการสำรองข้อมูลนี้อัปเดตล่าสุด %@\n\nการแทนที่สมุดบัญชีปัจจุบันอาจทำให้ธุรกรรมที่ใหม่กว่าสูญหาย"
          }
        }
      }
    },
