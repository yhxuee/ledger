    "Account Pass is static and refreshed manually. It does not use background push updates or bank transaction reading.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account Pass is static and refreshed manually. It does not use background push updates or bank transaction reading."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户凭证为静态凭证，仅在手动触发时刷新。不包含任何后台推送更新，亦不读取任何银行交易记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶憑證為靜態憑證，僅在手動觸發時重新整理。不包含任何背景推播更新，亦不讀取任何銀行交易記錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "口座パスは静的であり、手動でのみ更新されます。バックグラウンドプッシュ通知や銀行取引の自動読み取りは行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계좌 패스는 정적 패스이며 수동으로만 갱신됩니다. 백그라운드 푸시 업데이트나 은행 거래 내역 조회를 사용하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта счёта является статической и обновляется вручную. Фоновые push-обновления и чтение банковских операций не используются."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pase de cuenta es estático y se actualiza manualmente. No utiliza actualizaciones push en segundo plano ni lectura de transacciones bancarias."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kontopass ist statisch und wird manuell aktualisiert. Es werden keine Push-Aktualisierungen im Hintergrund oder das Auslesen von Banktransaktionen verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte de compte est statique et actualisée manuellement. Elle n'utilise pas de notifications push en arrière-plan ni la lecture des transactions bancaires."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัตรบัญชีเป็นแบบคงที่และรีเฟรชด้วยตนเอง ไม่ใช้การอัปเดตแบบพุชในเบื้องหลังหรือการอ่านธุรกรรมของธนาคาร"
          }
        }
      }
    },
