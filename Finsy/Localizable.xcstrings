    "Authorize this device for “%@”?\n\nThis will transfer the ledger encryption key wrapped with the new device's public key.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorize this device for “%@”?\n\nThis will transfer the ledger encryption key wrapped with the new device's public key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定为“%@”授权此设备吗？\n\n这将使用新设备的公钥加密并传输账本加密密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定為「%@」授權此裝置嗎？\n\n這將使用新裝置的公鑰加密並傳輸帳本加密金鑰。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」に対してこのデバイスを承認しますか？\n\nこれにより、新しいデバイスの公開鍵で暗号化された台帳暗号化キーが安全に転送されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'에 대해 이 기기를 승인하시겠습니까?\n\n새 기기의 공개 키로 암호화된 장부 암호화 키가 전송됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Авторизовать это устройство для «%@»?\n\nКлюч шифрования книги будет передан в зашифрованном виде с использованием открытого ключа нового устройства."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Autorizar este dispositivo para “%@”?\n\nEsto transferirá la clave de cifrado del libro protegida con la clave pública del nuevo dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät für „%@“ autorisieren?\n\nDadurch wird der Hauptbuch-Verschlüsselungsschlüssel mit dem öffentlichen Schlüssel des neuen Geräts übertragen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser cet appareil pour « %@ » ?\n\nCela transférera la clé de chiffrement du grand livre chiffrée avec la clé publique du nouvel appareil."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตอุปกรณ์นี้สำหรับ “%@” หรือไม่?\n\nการดำเนินการนี้จะถ่ายโอนคีย์การเข้ารหัสสมุดบัญชีที่ห่อหุ้มด้วยคีย์สาธารณะของอุปกรณ์ใหม่"
          }
        }
      }
    },
