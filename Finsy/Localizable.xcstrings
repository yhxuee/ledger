    "Cloud changes may still be pending. This backup will contain the latest data currently available on this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud changes may still be pending. This backup will contain the latest data currently available on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端同步可能仍在等待处理。此备份将包含当前此设备上可用的最新数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲端同步可能仍在等待處理。此備份將包含目前此裝置上可用的最新數據。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud変更が保留中の可能性があります。このバックアップには現在このデバイスで使用可能な最新データが含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 변경 사항이 대기 중일 수 있습니다. 이 백업에는 현재 이 기기에서 사용 가능한 최신 데이터가 포함됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация с облаком может продолжаться. Резервная копия будет содержать актуальные данные с этого устройства."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que los cambios en la nube sigan pendientes. Esta copia contendrá los últimos datos disponibles en este dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-Änderungen stehen möglicherweise noch aus. Diese Sicherung enthält die neuesten Daten auf diesem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des modifications cloud peuvent être en attente. Cette sauvegarde contiendra les dernières données disponibles sur cet appareil."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนแปลงบนคลาวด์อาจยังรอดำเนินการ การสำรองข้อมูลนี้จะมีข้อมูลล่าสุดที่มีอยู่บนอุปกรณ์นี้"
          }
        }
      }
    },
