    "Receipt stored securely outside the ledger JSON.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receipt stored securely outside the ledger JSON."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小票图片安全存储于账本 JSON 之外。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收據圖片安全儲存於帳本 JSON 之外。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシート画像は台帳JSONの外部に安全に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영수증 이미지는 장부 JSON 외부에 안전하게 저장됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чек надежно хранится отдельно от JSON книги."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El recibo se almacena de forma segura fuera del JSON del libro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beleg sicher außerhalb des Hauptbuch-JSON gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reçu stocké en toute sécurité hors du JSON du grand livre."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใบเสร็จจัดเก็บอย่างปลอดภัยภายนอก JSON ของสมุดบัญชี"
          }
        }
      }
    },
    "Receive a notification on the last day of each month to review and export your statements.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receive a notification on the last day of each month to review and export your statements."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每月最后一天接收提醒通知，以核对并导出您的月度账单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在每月最後一天接收提醒通知，以核對並匯出您的月度帳單。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎月最終日に通知を受け取り、明細書の確認とエクスポートを行えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매월 말일에 알림을 받아 월간 명세서를 검토하고 내보낼 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получайте уведомление в последний день месяца для проверки и экспорта выписок."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe una notificación el último día de cada mes para revisar y exportar tus extractos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalten Sie am letzten Tag jedes Monats eine Mitteilung, um Ihre Abrechnungen zu prüfen und zu exportieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez une notification le dernier jour du mois pour vérifier et exporter vos relevés."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับการแจ้งเตือนในวันสุดท้ายของแต่ละเดือนเพื่อตรวจสอบและส่งออกใบแจ้งยอดของคุณ"
          }
        }
      }
    },
