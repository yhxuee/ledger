        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機資料已重設。共享的 CloudKit 資料未受影響。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルアプリデータを初期化しました。共有CloudKitデータは削除されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 앱 데이터가 초기화되었습니다. 공유 CloudKit 데이터는 삭제되지 않았습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальные данные сброшены. Данные общего доступа в CloudKit не удалены."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se restablecieron los datos locales. Los datos compartidos de CloudKit no se eliminaron."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale App-Daten wurden zurückgesetzt. Geteilte CloudKit-Daten wurden nicht gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données locales ont été réinitialisées. Les données CloudKit partagées n'ont pas été supprimées."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลแอปในเครื่องถูกรีเซ็ตแล้ว ข้อมูล CloudKit ที่แชร์ไม่ได้ถูกลบ"
          }
        }
      }
