    "Finsy cannot recover an encrypted ledger if every authorized copy of its encryption key is lost. Keep at least one authorized device or transfer the key when replacing devices.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finsy cannot recover an encrypted ledger if every authorized copy of its encryption key is lost. Keep at least one authorized device or transfer the key when replacing devices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果账本加密密钥的所有已授权副本全部丢失，Finsy 将无法恢复加密账本。请保留至少一台已授权设备，或在更换设备时转移密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若帳本加密金鑰的所有已授權複本全部遺失，Finsy 將無法復原加密帳本。請保留至少一部已授權裝置，或在更換裝置時轉移金鑰。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認されたすべてのデバイスで暗号化キーが失われた場合、Finsyは暗号化された台帳を復元できません。少なくとも1台の承認済みデバイスを保持するか、デバイス交換時にキーを移行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인된 모든 기기에서 암호화 키를 분실하면 Finsy는 암호화된 장부를 복구할 수 없습니다. 최소 1대의 승인된 기기를 유지하거나 기기 교체 시 키를 이전하세요."
          }
        }
      }
    },
    "Finsy needs notification permission to send your daily bookkeeping reminders. Please enable notifications in iOS Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finsy needs notification permission to send your daily bookkeeping reminders. Please enable notifications in iOS Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finsy 需要通知权限以发送每日记账提醒。请在 iOS“设置”中开启通知权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Finsy 需要通知權限以發送每日記帳提醒。請在 iOS「設定」中開啟通知權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日の記録リマインダーを送信するには通知権限が必要です。iOSの「設定」で通知を有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 기록 알림을 보내려면 알림 권한이 필요합니다. iOS '설정'에서 알림을 켜주세요."
          }
        }
      }
    },
